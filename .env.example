# ============ PostgreSQL ============
PG_PASSWORD=change-me-in-prod
PG_DSN=postgresql+asyncpg://printsys:printsys@db:5432/printsys

# ============ Пути внутри контейнера ============
# Корни, внутри которых оператор может указывать папки-источники (разделитель ":").
# /data/share — сетевая шара, /data/uploads — папки, загруженные через UI.
DATA_ROOTS=/data

# ============ Сетевая шара ============
#
# ВАРИАНТ А (рекомендуется для прода): смонтировать шару на ХОСТЕ и прокинуть
# bind-mount. Хост занимается переподключением (autofs / systemd.mount / fstab).
#
#   sudo mount -t cifs //srv-docs/ksr /mnt/ksr \
#       -o credentials=/root/.smbcreds,ro,uid=0,gid=0,iocharset=utf8,vers=3.0
#
HOST_DATA_DIR=/mnt/ksr
#
# ВАРИАНТ Б: монтирование средствами Docker (CIFS-драйвер). Раскомментируйте
# том ksr_share в docker-compose и заполните переменные ниже.
# SMB_HOST=srv-docs
# SMB_SHARE=ksr
# SMB_USER=svc_printsys
# SMB_PASSWORD=
# SMB_DOMAIN=CORP

# ============ Сканирование ============
# Период автоматического скана, минут. 0 — только по кнопке.
SCAN_INTERVAL_MINUTES=10

# ============ Прочее ============
WEB_PORT=8000

# ============ Хранилища документов (MinIO, симуляция двух источников) ============
# Консоли: http://localhost:9191 (биллинг), http://localhost:9192 (документооборот)
S3_BILLING_KEY=billing_key
S3_BILLING_SECRET=billing_secret_123
S3_DOCFLOW_KEY=docflow_key
S3_DOCFLOW_SECRET=docflow_secret_123

# Заливка демо-документов с хоста: python scripts/seed_s3.py
# Путь к исходной папке (по умолчанию берётся из скрипта):
# SEED_SRC=C:/Users/ab/Desktop/Доки2
